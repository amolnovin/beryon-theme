{
    "name": "beryon/beryon-theme",
    "type": "wordpress-theme",
    "license": "GPL-3.0-or-later",
    "description": "قالب اختصاصی بریون (شرکت بریان گوشت آمل) بر پایه Sage 11 — RTL، ریسپانسیو، سازگار با ووکامرس، سئوی پیشرفته و به‌روزرسانی Patch-محور",
    "homepage": "https://beryon.com/",
    "authors": [
        {
            "name": "Beryon Web Team",
            "email": "info@beryon.com",
            "homepage": "https://beryon.com/"
        }
    ],
    "keywords": [
        "wordpress",
        "sage",
        "theme",
        "woocommerce",
        "rtl",
        "persian",
        "beryon"
    ],
    "support": {
        "issues": "https://beryon.com/contact-us/"
    },
    "require": {
        "php": ">=8.1",
        "roots/acorn": "^4.3",
        "symfony/var-dumper": "^6.4 || ^7.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "laravel/pint": "^1.15"
    },
    "suggest": {
        "woocommerce/woocommerce": "برای حالت فروشگاه/کاتالوگ ووکامرس (اختیاری — قالب بدون ووکامرس هم با CPT داخلی کار می‌کند)",
        "yoast/wordpress-seo": "اختیاری؛ سئوی داخلی قالب با آن تداخل ندارد و قابل غیرفعال‌سازی است"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "lint": [
            "phpcs --extensions=php --standard=PHPCompatibilityWP --runtime-set testVersion 8.1- app functions.php index.php",
            "phpcs --extensions=php --standard=WordPress app functions.php index.php"
        ],
        "lint:fix": [
            "phpcbf --extensions=php --standard=WordPress app functions.php index.php"
        ],
        "post-autoload-dump": [
            "Roots\\Acorn\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "roots/wordpress-no-content": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "installer-paths": {
            "vendor/roots/wordpress/": [
                "type:wordpress-core"
            ],
            "public/wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "public/wp-content/themes/{$name}/": [
                "type:wordpress-theme"
            ],
            "public/wp-content/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ]
        }
    }
}
