{
    "name": "beryon/beryon-theme",
    "private": true,
    "version": "1.0.0",
    "description": "Asset pipeline قالب بریون (Sage 11 + Vite)",
    "browserslist": [
        "extends browserslist-config-sage"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "translate": "npm run translate:pot && npm run translate:js",
        "translate:pot": "wp i18n make-pot . ./resources/lang/beryon.pot --headers='{\"Report-Msgid-Bugs-To\":\"https://beryon.com/\"}' --exclude=vendor,node_modules,public",
        "translate:js": "wp i18n make-json ./resources/lang --pretty-print"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "autoprefixer": "^10.4.19",
        "cssnano": "^7.0.1",
        "laravel-vite-plugin": "^1.0.4",
        "postcss": "^8.4.38",
        "postcss-logical": "^7.0.1",
        "tailwindcss": "^3.4.3",
        "vite": "^5.2.11"
    }
}
