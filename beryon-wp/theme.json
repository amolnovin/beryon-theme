{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": false,
        "color": {
            "custom": true,
            "customGradient": false,
            "defaultGradients": false,
            "defaultPalette": false,
            "palette": [
                { "slug": "brand", "color": "#d5232c", "name": "برند بریون" },
                { "slug": "brand-dark", "color": "#a4121b", "name": "برند تیره" },
                { "slug": "brand-light", "color": "#ff6a5e", "name": "برند روشن" },
                { "slug": "brand-soft", "color": "#fdeceb", "name": "برند ملایم" },
                { "slug": "ink", "color": "#181a1e", "name": "متن اصلی" },
                { "slug": "ink-soft", "color": "#3f424a", "name": "متن ثانویه" },
                { "slug": "muted", "color": "#6a6e77", "name": "متن کم‌رنگ" },
                { "slug": "surface", "color": "#fffaf7", "name": "پس‌زمینه" },
                { "slug": "line", "color": "#f1e3dc", "name": "خط جداکننده" },
                { "slug": "gold", "color": "#f5b301", "name": "طلایی" },
                { "slug": "green", "color": "#1e9e55", "name": "سبز" }
            ]
        },
        "custom": {
            "headerHeight": "80px",
            "radius": "20px"
        },
        "layout": {
            "contentSize": "1220px",
            "wideSize": "1220px"
        },
        "spacing": {
            "customSpacingSize": false,
            "units": ["px", "em", "rem", "vh", "vw", "%"]
        },
        "typography": {
            "customFontSize": true,
            "dropCap": false,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "Vazirmatn, system-ui, 'Segoe UI', Tahoma, Arial, sans-serif",
                    "slug": "vazirmatn",
                    "name": "وزیرمتن"
                }
            ],
            "fontSizes": [
                { "slug": "small", "size": "0.875rem", "name": "کوچک" },
                { "slug": "medium", "size": "1rem", "name": "متوسط" },
                { "slug": "large", "size": "1.25rem", "name": "بزرگ" },
                { "slug": "x-large", "size": "1.75rem", "name": "خیلی بزرگ" }
            ],
            "lineHeight": true
        },
        "useRootPaddingAwareAlignments": false
    },
    "styles": {
        "color": {
            "background": "#fffaf7",
            "text": "#3f424a"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "#d5232c",
                    "text": "#ffffff"
                },
                "border": { "radius": "14px" },
                "typography": { "fontWeight": "700", "fontFamily": "var(--wp--preset--font-family--vazirmatn)" }
            },
            "h1": { "typography": { "fontWeight": "900", "lineHeight": "1.45" }, "color": { "text": "#181a1e" } },
            "h2": { "typography": { "fontWeight": "900", "lineHeight": "1.5" }, "color": { "text": "#181a1e" } },
            "h3": { "typography": { "fontWeight": "800", "lineHeight": "1.5" }, "color": { "text": "#181a1e" } },
            "link": { "color": { "text": "#a4121b" } }
        },
        "spacing": {
            "blockGap": "1.25rem"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--vazirmatn)",
            "fontSize": "16px",
            "lineHeight": "1.9"
        }
    },
    "templateParts": [],
    "patterns": []
}
